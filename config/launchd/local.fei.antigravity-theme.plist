<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.fei.antigravity-theme</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_BIN__</string>
    <string>__HOME__/.antigravity-patch/daemon.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>__HOME__/.antigravity-patch</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__HOME__/.antigravity-patch/logs/launchd.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.antigravity-patch/logs/launchd-error.log</string>
</dict>
</plist>
