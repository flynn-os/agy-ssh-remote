# Runtime caches, extracted web bundles, and TLS self-signed certs
cache/
logs/
backups/
downloads/
node_modules/
__pycache__/
*.pyc
*.tmp
*.log
.DS_Store

# Secrets, private keys, TLS certificates, tokens, and local databases
.env
.env.*
*.pem
*.key
*.crt
*.p12
*.pfx
*oauth*
*token*
*secret*
*credential*
*.db
*.db-wal
*.db-shm
*.vscdb
*.pb
*.pbtxt

# Optional large local desktop font installers (installed in ~/Library/Fonts)
assets/fonts/*.ttf
fonts/*.ttf
